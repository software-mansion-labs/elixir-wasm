---
const memory = [
  { color: "bg-ink", name: "processes", value: "6.2 MB" },
  { color: "bg-brown-70", name: "binary", value: "3.1 MB" },
  { color: "bg-brown-60", name: "code", value: "7.4 MB" },
  { color: "bg-brown-50", name: "ets", value: "0.5 MB" },
  { color: "bg-brown-30", name: "atom + other", value: "1.2 MB" },
];

const metrics = [
  { name: "run queue", value: "0" },
  { name: "reductions / s", value: "1 214 300" },
];

const processMetrics = [
  { name: "count / limit", value: "42 / 262144" },
  { name: "gc runs", value: "1 284" },
  { name: "uptime", value: "00:01:47" },
];

const processes = [
  { pid: "#PID<0.112.0>", name: "Greeter.loop" },
  { pid: "#PID<0.108.0>", name: "IEx.Evaluator" },
  { pid: "#PID<0.94.0>", name: "Popcorn.Supervisor" },
];

const figures = [
  { label: "Memory", value: "18.4 MB" },
  { label: "Processes", value: "42" },
  { label: "Reductions/s", value: "1.2 M" },
];
---

<section
  class="bg-cream border-demo relative flex h-full w-full min-w-0 flex-col overflow-hidden rounded-md border antialiased"
  aria-label="Interactive Elixir demo"
  data-iex-demo
>
  <nav
    class="border-demo-soft flex h-14 flex-none border-b md:h-18"
    aria-label="IEx examples"
  >
    <div
      class="flex min-w-0 flex-1 items-center gap-2 overflow-x-auto px-3 md:gap-2.5 md:px-5.5"
    >
      <button
        class="bg-orange-20 aria-pressed:bg-orange font-copy md:font-label flex-none cursor-pointer rounded-full px-3 py-2 text-xs leading-4 font-medium aria-pressed:text-white md:rounded-sm md:px-4 md:py-2.25 md:text-sm md:leading-4.5"
        type="button"
        data-iex-example="greet"
        aria-pressed="true">Greet a process</button
      >
      <button
        class="border-demo font-copy text-ink aria-pressed:bg-orange md:font-label flex-none cursor-pointer rounded-full border px-3 py-2 text-xs leading-4 font-medium aria-pressed:border-transparent aria-pressed:text-white md:rounded-sm md:px-4 md:py-2 md:text-sm md:leading-4.5"
        type="button"
        data-iex-example="sort"
        aria-pressed="false">Enum.sort/1</button
      >
      <button
        class="border-demo font-copy text-ink aria-pressed:bg-orange md:font-label flex-none cursor-pointer rounded-full border px-3 py-2 text-xs leading-4 font-medium aria-pressed:border-transparent aria-pressed:text-white md:rounded-sm md:px-4 md:py-2 md:text-sm md:leading-4.5"
        type="button"
        data-iex-example="supervise"
        aria-pressed="false">Supervise a crash</button
      >
    </div>

    <button
      class="border-demo-soft text-ink font-copy flex w-11.5 flex-none cursor-pointer items-center justify-center gap-2 border-l text-sm md:w-auto md:border-0 md:px-5.5"
      type="button"
      aria-label="Restart IEx"
      data-iex-restart
    >
      <svg class="size-3.5 flex-none" viewBox="0 0 14 14" aria-hidden="true">
        <path
          d="M12 7a5 5 0 1 1-1.6-3.7M12.2 1.4v2.9H9.3"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
      <span class="hidden md:inline">Restart</span>
    </button>
  </nav>

  <div class="@min-demos/demos:flex-row flex min-h-0 flex-1 flex-col">
    <div
      class="bg-cream-terminal @min-demos/demos:h-auto @min-demos/demos:flex-1 relative h-53 min-h-0 flex-none overflow-hidden md:h-75"
      data-iex-terminal
    >
    </div>

    <aside
      class="bg-cream @min-demos/demos:flex hidden w-95 flex-none flex-col gap-6 p-6.5"
      aria-label="Runtime details"
    >
      <div class="flex flex-col gap-3">
        <span
          class="font-label text-brown-60 tracking-label text-xs leading-4.5 font-medium uppercase"
          >Memory</span
        >
        <strong class="font-label text-ink text-2xl leading-8 font-medium"
          >18.4 MB</strong
        >
        <div class="flex h-2.5 overflow-hidden rounded-sm" aria-hidden="true">
          <span class="bg-ink w-1/3"></span>
          <span class="bg-brown-70 w-1/6"></span>
          <span class="bg-brown-60 w-2/5"></span>
          <span class="bg-brown-50 w-1/24"></span>
          <span class="bg-brown-30 flex-1"></span>
        </div>
        <dl class="font-label text-sm leading-5.5">
          {
            memory.map(({ color, name, value }) => (
              <div class="flex items-center gap-3 py-0.75">
                <span
                  class:list={["size-2 flex-none rounded-sm", color]}
                  aria-hidden="true"
                />
                <dt class="text-brown-70 min-w-0 flex-1">{name}</dt>
                <dd class="text-ink w-19 flex-none text-right">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="border-demo-soft flex flex-col gap-2 border-t pt-5">
        <span
          class="font-label text-brown-60 tracking-label text-xs leading-4.5 font-medium uppercase"
          >Load</span
        >
        {
          metrics.map(({ name, value }) => (
            <dl class="font-label flex min-w-0 items-center gap-3 text-sm leading-5.5">
              <dt class="text-brown-70 min-w-0 flex-1">{name}</dt>
              <dd class="text-ink w-27.5 flex-none text-right">{value}</dd>
            </dl>
          ))
        }
        <p class="font-copy text-brown-60 text-sm leading-5.5">
          Popcorn runs one scheduler thread. Load is reported as run queue
          length and reductions per second.
        </p>
      </div>

      <div class="border-demo-soft flex min-h-0 flex-col gap-2 border-t pt-5">
        <span
          class="font-label text-brown-60 tracking-label text-xs leading-4.5 font-medium uppercase"
          >Processes</span
        >
        {
          processMetrics.map(({ name, value }) => (
            <dl class="font-label flex min-w-0 items-center gap-3 text-sm leading-5.5">
              <dt class="text-brown-70 min-w-0 flex-1">{name}</dt>
              <dd class="text-ink w-27.5 flex-none text-right">{value}</dd>
            </dl>
          ))
        }
        <dl class="font-label mt-1.5 flex min-w-0 flex-col text-sm leading-5.5">
          {
            processes.map(({ pid, name }) => (
              <div class="flex min-w-0 items-baseline gap-3.5 py-0.75">
                <dt class="text-ink w-29.5 flex-none">{pid}</dt>
                <dd class="text-brown-60 min-w-0 flex-1 truncate" title={name}>
                  {name}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </aside>
  </div>

  <footer
    class="border-demo-soft bg-cream @min-demos/demos:hidden relative flex flex-none items-start gap-3 border-t px-4 py-3.5 md:items-center md:justify-between md:gap-6 md:px-5.5 md:py-4.5"
  >
    <dl
      class="grid min-w-0 flex-1 grid-cols-3 gap-3 md:flex md:items-end md:gap-11"
    >
      {
        figures.map(({ label, value }) => (
          <div class="flex min-w-0 flex-col gap-0.75 md:w-32 md:flex-none md:gap-1">
            <dt class="font-label text-brown-60 tracking-label truncate text-xs leading-4 font-medium uppercase md:leading-4.5">
              {label}
            </dt>
            <dd class="font-label text-ink truncate text-sm leading-5.5 md:text-2xl md:leading-8">
              {value}
            </dd>
          </div>
        ))
      }
    </dl>
    <button
      class="border-demo font-copy text-ink hidden cursor-pointer items-center gap-2 rounded-sm border px-4 py-2.25 text-sm font-medium md:flex"
      type="button"
      aria-expanded="false"
      data-iex-details
    >
      Details
      <svg class="size-3 flex-none" viewBox="0 0 12 8" aria-hidden="true">
        <path
          d="M1 6.5 6 1.5l5 5"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>

    <div
      class="border-demo bg-cream absolute inset-x-5 bottom-full hidden max-h-60 overflow-y-auto rounded-t-md border p-5 max-md:hidden"
      data-iex-details-panel
    >
      <span
        class="font-label text-brown-60 tracking-label text-xs leading-4.5 font-medium uppercase"
        >Processes</span
      >
      <dl class="font-label mt-3 flex min-w-0 flex-col text-sm leading-5.5">
        {
          [
            ...processes.slice(0, 2),
            {
              pid: "#PID<0.94.0>",
              name: "Popcorn.Supervisor.With.An.Extremely.Long.Registered.Process.Name.That.Must.Not.Break.The.Layout",
            },
          ].map(({ pid, name }) => (
            <div class="flex min-w-0 items-baseline gap-3.5 py-0.75">
              <dt class="text-ink w-29.5 flex-none">{pid}</dt>
              <dd class="text-brown-60 min-w-0 flex-1 truncate" title={name}>
                {name}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </footer>

  <p class="sr-only" aria-live="polite" data-iex-status>
    Starting the Elixir runtime
  </p>
</section>

<script>
  import { Popcorn } from "@swmansion/popcorn";
  import { FitAddon, init, Terminal } from "ghostty-web";

  const SHELL_ARGS = [
    "-elixir_root",
    "/lib",
    "-user",
    "elixir",
    "-extra",
    "--no-halt",
    "+iex",
    "--dot-iex",
    "",
  ];

  const GREETER_MODULE =
    'defmodule Greeter do; def loop do; receive do; {:greet, name} -> IO.puts("Hello, #{name}"); loop() end end end';

  const EXAMPLES = {
    greet: [
      "pid = spawn(Greeter, :loop, [])",
      'send(pid, {:greet, "Popcorn"})',
    ],
    sort: ["Enum.sort([:popcorn, :beam, :elixir])"],
    supervise: [
      "{:ok, supervisor} = Supervisor.start_link([{Agent, fn -> 0 end}], strategy: :one_for_one)",
      "[{_, pid, _, _}] = Supervisor.which_children(supervisor)",
      "Process.exit(pid, :kill)",
      "Supervisor.which_children(supervisor)",
    ],
  };

  for (const demo of document.querySelectorAll<HTMLElement>(
    "[data-iex-demo]",
  )) {
    setupDemo(demo);
  }

  async function setupDemo(demo: HTMLElement) {
    const terminalElement = demo.querySelector<HTMLElement>(
      "[data-iex-terminal]",
    );
    const status = demo.querySelector<HTMLElement>("[data-iex-status]");
    const restart = demo.querySelector<HTMLButtonElement>("[data-iex-restart]");
    const details = demo.querySelector<HTMLButtonElement>("[data-iex-details]");
    const detailsPanel = demo.querySelector<HTMLElement>(
      "[data-iex-details-panel]",
    );
    const exampleButtons =
      demo.querySelectorAll<HTMLButtonElement>("[data-iex-example]");

    console.assert(terminalElement instanceof HTMLElement);
    console.assert(status instanceof HTMLElement);
    console.assert(restart instanceof HTMLButtonElement);
    if (
      !(terminalElement instanceof HTMLElement) ||
      !(status instanceof HTMLElement) ||
      !(restart instanceof HTMLButtonElement)
    ) {
      return;
    }

    let popcorn: Popcorn | null = null;
    let terminal: Terminal | null = null;

    if (
      details instanceof HTMLButtonElement &&
      detailsPanel instanceof HTMLElement
    ) {
      details.addEventListener("click", () => {
        const expanded = details.getAttribute("aria-expanded") === "true";
        details.setAttribute("aria-expanded", String(!expanded));
        detailsPanel.classList.toggle("hidden", expanded);
      });
    }

    for (const button of exampleButtons) {
      button.addEventListener("click", () => {
        if (popcorn === null) return;

        for (const candidate of exampleButtons) {
          candidate.setAttribute("aria-pressed", String(candidate === button));
        }

        const name = button.dataset.iexExample;
        console.assert(
          name === "greet" || name === "sort" || name === "supervise",
        );
        if (name !== "greet" && name !== "sort" && name !== "supervise") return;

        runExample(popcorn, EXAMPLES[name]);
      });
    }

    restart.addEventListener("click", async () => {
      if (popcorn !== null) popcorn.deinit();
      if (terminal !== null) terminal.dispose();
      terminalElement.replaceChildren();
      ({ popcorn, terminal } = await startTerminal(
        terminalElement,
        status,
        exampleButtons,
        restart,
      ));
    });

    ({ popcorn, terminal } = await startTerminal(
      terminalElement,
      status,
      exampleButtons,
      restart,
    ));
  }

  async function startTerminal(
    terminalElement: HTMLElement,
    status: HTMLElement,
    exampleButtons: NodeListOf<HTMLButtonElement>,
    restart: HTMLButtonElement,
  ) {
    setLoading(exampleButtons, restart, true);
    status.textContent = "Starting the Elixir runtime";
    terminalElement.dataset.ready = "false";

    await init();

    const styles = getComputedStyle(document.documentElement);
    const terminal = new Terminal({
      cursorBlink: true,
      cursorStyle: "bar",
      fontFamily: "IBM Plex Mono",
      fontSize: window.matchMedia("(max-width: 47.999rem)").matches ? 12 : 14,
      scrollback: 1_000,
      theme: {
        background: styles.getPropertyValue("--color-cream-terminal").trim(),
        foreground: styles.getPropertyValue("--color-ink").trim(),
        cursor: styles.getPropertyValue("--color-orange").trim(),
        cursorAccent: styles.getPropertyValue("--color-cream-terminal").trim(),
        black: styles.getPropertyValue("--color-ink").trim(),
        red: styles.getPropertyValue("--color-orange-text").trim(),
        green: styles.getPropertyValue("--color-brown-70").trim(),
        yellow: styles.getPropertyValue("--color-orange").trim(),
        blue: styles.getPropertyValue("--color-brown-60").trim(),
        magenta: styles.getPropertyValue("--color-orange").trim(),
        cyan: styles.getPropertyValue("--color-brown-70").trim(),
        white: styles.getPropertyValue("--color-cream").trim(),
        brightBlack: styles.getPropertyValue("--color-brown-60").trim(),
        brightRed: styles.getPropertyValue("--color-orange").trim(),
        brightGreen: styles.getPropertyValue("--color-brown-70").trim(),
        brightYellow: styles.getPropertyValue("--color-orange").trim(),
        brightBlue: styles.getPropertyValue("--color-brown-60").trim(),
        brightMagenta: styles.getPropertyValue("--color-orange").trim(),
        brightCyan: styles.getPropertyValue("--color-brown-70").trim(),
        brightWhite: styles.getPropertyValue("--color-cream").trim(),
        selectionBackground: styles
          .getPropertyValue("--color-orange-20")
          .trim(),
      },
    });
    const fitAddon = new FitAddon();
    terminal.loadAddon(fitAddon);

    const nativeFocus = terminalElement.focus.bind(terminalElement);
    terminalElement.focus = () => nativeFocus({ preventScroll: true });
    terminal.open(terminalElement);
    fitAddon.fit();
    fitAddon.observeResize();
    terminal.writeln("\x1b[90mBooting BEAM and starting IEx…\x1b[0m");

    const result = await Popcorn.init({
      beam: {
        otpAssetsRoot: "/_astro/otp/",
        env: { TERM: "xterm-256color" },
        extraArgs: SHELL_ARGS,
      },
      tty: { size: ttySize(terminal) },
      timeoutsMs: { boot: 30_000 },
      onStdout: (chunk) => terminal.write(chunk),
      onStderr: (chunk) => terminal.write(chunk),
      onError: (error) => {
        status.textContent = `Runtime ${error.kind}: ${error.data}`;
      },
    });

    if (result.ok === false) {
      status.textContent = "The Elixir runtime failed to start";
      terminal.writeln(`\r\n\x1b[31m${result.error.message}\x1b[0m`);
      throw result.error;
    }

    const popcorn = result.data;
    terminal.onData((data) => {
      const input = popcorn.writeStdin(data);
      if (input.ok === false) status.textContent = input.error.message;
    });
    terminal.onResize(({ cols, rows }) => {
      const resize = popcorn.resizeTty(cols, rows);
      if (resize.ok === false) status.textContent = resize.error.message;
    });

    fitAddon.fit();
    const resize = popcorn.resizeTty(terminal.cols, terminal.rows);
    console.assert(resize.ok);
    terminalElement.dataset.ready = "true";
    status.textContent = "IEx is ready";
    setLoading(exampleButtons, restart, false);
    for (const button of exampleButtons) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.iexExample === "greet"),
      );
    }
    const setup = popcorn.writeStdin(`${GREETER_MODULE}\r\f`);
    console.assert(setup.ok);
    runExample(popcorn, EXAMPLES.greet);

    return { popcorn, terminal };
  }

  function runExample(popcorn: Popcorn, commands: string[]) {
    const clear = popcorn.writeStdin("\f");
    console.assert(clear.ok);

    for (const command of commands) {
      const input = popcorn.writeStdin(`${command}\r`);
      console.assert(input.ok);
    }
  }

  function setLoading(
    exampleButtons: NodeListOf<HTMLButtonElement>,
    restart: HTMLButtonElement,
    loading: boolean,
  ) {
    restart.disabled = loading;
    for (const button of exampleButtons) button.disabled = loading;
  }

  function ttySize(terminal: Terminal) {
    console.assert(terminal.cols > 0);
    console.assert(terminal.rows > 0);
    return { columns: terminal.cols, rows: terminal.rows };
  }
</script>

<style is:global>
  [data-iex-terminal],
  [data-iex-terminal] textarea {
    caret-color: var(--color-transparent);
  }

  [data-iex-terminal] textarea {
    color: var(--color-transparent);
    background: var(--color-transparent);
  }

  [data-iex-terminal] canvas {
    max-width: none;
  }
</style>
